{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest-browser-vue", "@vitest/browser-playwright", "vite/client"]
  },
  "include": ["components/**/*.ts", "vue-consumer/**/*.ts", "../app/**/*.ts", "../app/**/*.vue", "../index.ts", "../docs/demos/**/*.vue"],
  "exclude": ["../app/plugins/**"]
}
